# demo works without Docker or paid API access; opensearch uses the real service.
SEARCH_BACKEND=demo
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=talentlens-profiles-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Server-only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
